# TalkEnglish Configuration
# Copy this file to .env and configure your credentials:
# cp .env.example .env

# OpenAI or OpenAI-compatible provider API key
TRANSLATOR_API_KEY="your-api-key-here"

# API Base URL (defaults to https://api.openai.com/v1 if unset)
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Local proxy:  http://localhost:20128/v1
#   Ollama:       http://localhost:11434/v1
TRANSLATOR_API_BASE="https://api.openai.com/v1"

# Model identifier
# Examples: gpt-4o-mini, ag/gemini-3.8-flash-low, mistralai/mistral-small, etc.
TRANSLATOR_MODEL="gpt-4o-mini"
